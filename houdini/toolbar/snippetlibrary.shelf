<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
  <toolshelf name="snippetlibrary" label="SnippetLibrary">
    <memberTool name="snippetlib_save"/>
    <memberTool name="snippetlib_load"/>
    <memberTool name="snippetlib_viewer"/>
  </toolshelf>

  <tool name="snippetlib_save" label="Lib Save" icon="BUTTONS_upload">
    <helpText><![CDATA[Save the selected network items to the Snippet Library.]]></helpText>
    <script scriptType="python"><![CDATA[import snippetlib.houdini_io as m
m.save_selected_dialog()]]></script>
  </tool>

  <tool name="snippetlib_load" label="Lib Load" icon="BUTTONS_download">
    <helpText><![CDATA[Browse the Snippet Library and load a snippet into the current network.]]></helpText>
    <script scriptType="python"><![CDATA[import snippetlib.houdini_io as m
m.show_browser()]]></script>
  </tool>

  <tool name="snippetlib_viewer" label="Lib Viewer" icon="BUTTONS_internet">
    <helpText><![CDATA[Open the Snippet Library viewer in the browser.]]></helpText>
    <script scriptType="python"><![CDATA[import snippetlib.houdini_io as m
m.open_viewer()]]></script>
  </tool>
</shelfDocument>
